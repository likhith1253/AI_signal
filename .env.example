# Pooled connection string (Neon: the "-pooler" host). Used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/oneatlas?sslmode=require"
# Direct (non-pooled) connection string. Used by Prisma migrations.
DIRECT_URL="postgresql://user:password@host:5432/oneatlas?sslmode=require"
# Bearer token required by POST /api/ingest. Generate with: openssl rand -hex 32
INGEST_SECRET=""
# Optional: Vercel cron sends this as a bearer token to /api/cron/ingest
CRON_SECRET=""
